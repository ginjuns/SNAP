; 이 파일을 server.ini 로 복사한 뒤 값을 수정하세요.
; server.ini 는 비밀번호가 들어 있으므로 git에 올라가지 않습니다(.gitignore).
; server/ 폴더(또는 KioskClient 실행 폴더)에 두면 됩니다.

[mysql]
host=127.0.0.1
port=3306
database=kiosk
user=kiosk
password=kiosk1234

; AI 판매 분석
; 1순위 Groq (console.groq.com 에서 발급한 무료 API 키). 한도는 모델마다 따로라서
;   groq_model 이 한도 초과/혼잡이면 groq_fallback_model 로 넘어갑니다.
; 2순위 Gemini (선택, aistudio.google.com 의 API 키). 비워 두면 쓰지 않습니다.
[ai]
groq_key=
groq_model=openai/gpt-oss-120b
groq_fallback_model=openai/gpt-oss-20b
gemini_key=
gemini_model=gemini-3.5-flash-lite
