; 이 파일을 server.ini 로 복사한 뒤 값을 수정하세요.
; server.ini 는 비밀번호가 들어 있으므로 git에 올라가지 않습니다(.gitignore).
; server/ 폴더(또는 KioskClient 실행 폴더)에 두면 됩니다.

[mysql]
host=127.0.0.1
port=3306
database=kiosk
user=kiosk
password=kiosk1234

; AI 판매 분석 - Gemini API (aistudio.google.com 에서 발급한 API 키)
; model 은 AI Studio 에서 쓸 수 있는 모델 이름으로 바꿔도 됩니다.
; fallback_model 은 model 이 혼잡(503)할 때 대신 쓰는 예비 모델입니다.
[ai]
api_key=
model=gemini-2.5-flash
fallback_model=gemini-2.5-flash-lite
; 0 = AI의 생각 단계를 꺼서 빠르게 답함, -1 = 모델 기본값 (오류가 나면 -1로)
thinking_budget=0
