; 이 파일을 server.ini 로 복사한 뒤 값을 수정하세요.
; server.ini 는 비밀번호가 들어 있으므로 git에 올라가지 않습니다(.gitignore).
; server/ 폴더(또는 KioskClient 실행 폴더)에 두면 됩니다.

[mysql]
host=127.0.0.1
port=3306
database=kiosk
user=kiosk
password=kiosk1234

; AI 판매 분석 (Groq 만 사용)
; groq_key 는 console.groq.com/keys 에서 발급한 API 키.
; 한도는 모델마다 따로라서 groq_model 이 한도 초과/혼잡이면 groq_fallback_model 로 넘어갑니다.
[ai]
groq_key=
groq_model=openai/gpt-oss-120b
groq_fallback_model=openai/gpt-oss-20b

; 토스페이먼츠 결제 승인 (앱 잔액 충전)
; 앱의 클라이언트 키(test_gck_...)와 짝인 시크릿 키(test_gsk_... / live_gsk_...)를 넣습니다.
; 비워 두면 앱 충전(CHARGE)을 받지 않습니다. 시크릿 키는 git 에 올리지 마세요.
[toss]
secret_key=

; 관리자 회원가입 코드
; 안드로이드 앱에서 회원가입할 때 이 코드를 입력해야 관리자로 가입됩니다.
; 비워 두면 관리자 가입을 받지 않습니다. 코드가 틀리면 가입이 거절됩니다.
[admin]
signup_code=
